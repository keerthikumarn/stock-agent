# --- Required -----------------------------------------------------------------
# Shared secret between agent and MCP server (generate: openssl rand -hex 32)
MCP_AUTH_TOKEN=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# --- LLM ------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:latest
# Set when moving to a paid model so cost is tracked (USD per 1K tokens)
LLM_COST_PER_1K_INPUT_TOKENS=0
LLM_COST_PER_1K_OUTPUT_TOKENS=0

# --- Observability -------------------------------------------------------------
DEPLOYMENT_ENVIRONMENT=dev
LOG_LEVEL=INFO
# false = log sizes only, never prompt/tool content (use where PII rules apply)
LOG_PAYLOADS=true
# Head sampling: 1.0 = keep every trace; e.g. 0.1 in high-traffic prod
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
